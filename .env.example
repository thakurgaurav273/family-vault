# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Enable the Google Drive API. Authorized redirect URI: <APP_URL>/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Neon: project dashboard -> Connection string (use the pooled one, sslmode=require)
DATABASE_URL=
# Resend: https://resend.com/api-keys ; EMAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=FamilyVault <invites@yourdomain.com>

# Sign sessions with a secret that is NOT stored in the database (openssl rand -hex 32)
SESSION_SECRET=
# Set to 1 when behind a reverse proxy (Render, Fly, nginx) so rate limiting sees real IPs
TRUST_PROXY=
MAX_UPLOAD_MB=2048

# Sign sessions with a secret NOT stored in the database (openssl rand -hex 32)
SESSION_SECRET=
# Set to 1 behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=
MAX_UPLOAD_MB=2048

# Sign sessions with a secret NOT stored in the database (openssl rand -hex 32)
SESSION_SECRET=
# Set to 1 behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=
MAX_UPLOAD_MB=2048

# Public pages (landing, /privacy, /terms). VITE_* values are public and baked in at BUILD time.
# Shown on the legal pages; unset values render as a visible "[Owner: set ...]" placeholder.
VITE_SUPPORT_EMAIL=
VITE_OPERATOR_NAME=
VITE_APP_URL=
